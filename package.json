{
  "name": "smart-ticketing-wallet",
  "version": "2.0.0",
  "description": "Smart Digital Ticketing Engine & Wallet inspired by Quentro (Dynamic QR TOTP 15s, 100% Offline Turnstile Check-in, P2P Transfers & Anti-Scalping Governance) conforming to AI-SDLC Framework",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npx tsx --test tests/**/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/validate-task-ids.mjs",
    "validate:tasks": "node scripts/validate-task-ids.mjs",
    "precommit:audit": "node scripts/pre-commit-guard.mjs",
    "dashboard": "npx tsx scripts/serve-dashboard.ts",
    "demo:live": "npx tsx scripts/demo-live.ts",
    "deploy:cf": "npx wrangler pages deploy ./dist --project-name smart-ticketing-wallet --branch main",
    "eval:task": "node evals/harness.mjs --task task-001",
    "eval:task:002": "node evals/harness.mjs --task task-002",
    "eval:task:003": "node evals/harness.mjs --task task-003",
    "eval:task:004": "node evals/harness.mjs --task task-004"
  },
  "keywords": [
    "smart-tickets",
    "quentro",
    "dynamic-qr",
    "totp",
    "rfc6238",
    "offline-checkin",
    "anti-scalping",
    "ai-sdlc"
  ],
  "author": "TrautsLab",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
